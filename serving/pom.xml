<?xml version="1.0" encoding="UTF-8"?>
<!--
  这是 Maven 的项目描述文件。
  Spring Boot 的依赖版本统一由 spring-boot-starter-parent 管理，避免自己逐个指定版本。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- 固定使用 Maven 4.0.0 模型 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 的父 POM：统一管理 Spring、Jackson、JUnit、Mockito 等版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/> <!-- 从 Maven 仓库解析，而不是从本地目录找 -->
    </parent>

    <!-- 本项目坐标 -->
    <groupId>com.example</groupId>
    <artifactId>doris-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>doris-demo</name>
    <description>Spring Boot + Apache Doris 3/4.x 教学示例</description>

    <properties>
        <!-- 编译和运行都使用 Java 21（Spring Boot 3.x 的基线是 17，21 是当前 LTS） -->
        <java.version>21</java.version>
        <!-- Doris 官方推荐 MySQL 协议驱动；8.4.0 是 MySQL 的 LTS 驱动版本，兼容 Doris 的 9030 端口 -->
        <mysql-connector.version>8.4.0</mysql-connector.version>
    </properties>

    <dependencies>
        <!-- Web：提供 Tomcat、Spring MVC、Jackson，用来写 REST 接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JDBC：提供 DataSource、JdbcTemplate、事务、HikariCP 连接池 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 参数校验：@NotNull、@Positive、@Valid 等注解来自这里 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MySQL Connector/J：Doris 兼容 MySQL 协议，所以用 MySQL 驱动连 9030 端口 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector.version}</version>
            <scope>runtime</scope> <!-- 只在运行期需要，编译期代码不直接引用驱动类 -->
        </dependency>

        <!-- 测试：JUnit 5、AssertJ、Mockito、Spring Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打成可执行 jar：mvn package 后 java -jar target/doris-demo-0.0.1-SNAPSHOT.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
